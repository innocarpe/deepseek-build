# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~

# Build / deps (reserved; stack not locked yet)
/target/
/node_modules/
/dist/
/build/
.bun/

# Local secrets & machine state
.env
.env.*
!.env.example
*.pem
*.key

# Agent harness: .claude/ and .agents/ track only their skill links (ADR 0011).
# Tools write per-user state beside them (settings.local.json, worktrees/,
# scheduled_tasks.json, ...); keep all of it local.
/.claude/*
!/.claude/skills
/.agents/*
!/.agents/skills

# Runtime / session debris
.deepseek-build/sessions/
.deepseek-build/cache/
.deepseek-build/logs/
*.log

# Coverage / tooling
coverage/
.nyc_output/
*.profraw
.omc/

# Vendored Grok Build workspace (ADR-0008) — never commit build artifacts
third_party/grok-build/target/
third_party/grok-build/**/target/
third_party/grok-build/.gjc/
third_party/grok-build/.omc/
third_party/grok-build/**/.DS_Store
# macOS drops a zero-byte Spotlight marker into build directories; it is never
# tracked and would otherwise show up as dirt in every worktree here
# (`git status` in the worktree-dispatch cleanup gate).
**/.metadata_never_index

# Pre-3.x baseline runtime results (local only)
docs/product/evidence/_last_pre3x_*.tsv

# L3 smoke runtime results
docs/product/evidence/_last_l3_smoke.tsv
