--- a/third_party/grok-build/crates/codegen/xai-grok-pager/src/app/dispatch/tests/settings.rs
+++ b/third_party/grok-build/crates/codegen/xai-grok-pager/src/app/dispatch/tests/settings.rs
@@ -3151,3 +3151,3 @@ fn set_auto_dark_theme_emits_persist_setting_with_correct_payload() {
                 assert_eq!(*value, SettingValue::Enum("grokday"));
-                assert_eq!(*rollback_value, SettingValue::Enum("deepseeknight-v2"));
+                assert_eq!(*rollback_value, SettingValue::Enum("deepseeknight"));
             }
